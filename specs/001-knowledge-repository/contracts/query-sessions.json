{
  "openapi": "3.0.3",
  "info": {
    "title": "Query Sessions API",
    "description": "Retrieve session history with replay links",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{ngrok-url}/webhook",
      "description": "Development server (ngrok tunnel)",
      "variables": {
        "ngrok-url": {
          "default": "your-ngrok-subdomain.ngrok.io"
        }
      }
    }
  ],
  "paths": {
    "/query_sessions": {
      "post": {
        "summary": "Query session history",
        "description": "Retrieve sessions with optional filters by project, date range, status, and AI type. Returns session metadata including recording file paths for replay.",
        "operationId": "querySessions",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuerySessionsRequest"
              },
              "examples": {
                "all": {
                  "summary": "List all sessions",
                  "value": {}
                },
                "project_filtered": {
                  "summary": "Sessions for specific project",
                  "value": {
                    "filters": {
                      "project": "Noel"
                    }
                  }
                },
                "date_range": {
                  "summary": "Sessions in date range",
                  "value": {
                    "filters": {
                      "date_from": "2025-11-01",
                      "date_to": "2025-11-30",
                      "status": "Completed"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sessions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuerySessionsResponse"
                },
                "example": {
                  "success": true,
                  "sessions": [
                    {
                      "session_id": "SESSION-20251120-001",
                      "projects": ["Noel"],
                      "goals": "Implement session tracking and replay",
                      "start_time": "2025-11-20T09:00:00Z",
                      "end_time": "2025-11-20T11:30:00Z",
                      "duration_minutes": 150,
                      "status": "Completed",
                      "ai_type": "Claude",
                      "recording_file_path": "~/coding-sessions/2025-11-20-claude-noel-001.cast",
                      "recording_format": "asciinema",
                      "learning_count": 3
                    }
                  ],
                  "count": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QuerySessionsRequest": {
        "type": "object",
        "properties": {
          "filters": {
            "type": "object",
            "properties": {
              "project": {
                "type": "string",
                "description": "Filter by project name"
              },
              "date_from": {
                "type": "string",
                "format": "date",
                "description": "Start of date range (YYYY-MM-DD)"
              },
              "date_to": {
                "type": "string",
                "format": "date",
                "description": "End of date range (YYYY-MM-DD)"
              },
              "status": {
                "type": "string",
                "enum": ["Active", "Completed", "Abandoned"],
                "description": "Filter by session status"
              },
              "ai_type": {
                "type": "string",
                "enum": ["Claude", "Gemini", "Other"],
                "description": "Filter by AI assistant type"
              }
            }
          }
        }
      },
      "QuerySessionsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          },
          "count": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "example": "SESSION-20251120-001"
          },
          "projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": ["Noel"]
          },
          "goals": {
            "type": "string",
            "example": "Implement session tracking and replay"
          },
          "start_time": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-20T09:00:00Z"
          },
          "end_time": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2025-11-20T11:30:00Z"
          },
          "duration_minutes": {
            "type": "integer",
            "description": "Session duration in minutes (real-time for active sessions)",
            "example": 150
          },
          "status": {
            "type": "string",
            "example": "Completed"
          },
          "ai_type": {
            "type": "string",
            "example": "Claude"
          },
          "recording_file_path": {
            "type": "string",
            "description": "Path to asciinema recording for replay",
            "example": "~/coding-sessions/2025-11-20-claude-noel-001.cast"
          },
          "recording_format": {
            "type": "string",
            "example": "asciinema"
          },
          "learning_count": {
            "type": "integer",
            "description": "Number of learnings captured during session",
            "example": 3
          }
        }
      }
    }
  }
}
