        "jsCode": "const args = $('Parse Message').item.json.args || '';\nif (args.length < 3) {\n  return [{json: {is_error: true, error_message: 'Query too short. Use:\\n/query search terms\\n\\nMin 3 characters.'}}];\n}\nreturn [{json: {\n  is_error: false,\n  noel_payload: {endpoint: 'query_learnings', query: args, limit: 5}\n}}];"
