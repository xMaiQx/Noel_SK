      "parameters": {
        "jsCode": "return [{json: {\n  response_text: '\\ud83e\\udde0 *Noel Knowledge Bot*\\n\\n' +\n    'Commands:\\n' +\n    '/capture Title | Content - Capture a learning\\n' +\n    '/query search terms - Search learnings\\n' +\n    '/status - System statistics\\n' +\n    '/projects - List projects\\n' +\n    '/help - This reference\\n\\n' +\n    'Capture format:\\n' +\n    '`/capture Bug Fix | WHY: reason WHAT: solution HOW: steps`'\n}}];"
      },
      "id": "574dd979-3cb3-43f8-b29d-46093be59616",
      "name": "Help Text",
      "type": "n8n-nodes-base.code",
